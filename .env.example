# ---- Exchange root configuration example ----
# Copy to Server/.env (and/or export in your shell) and adjust as needed.

# REST API
PORT=3000
JWT_SECRET=dev-secret-change-me-in-production-please
JWT_EXPIRES_IN=7d

# PostgreSQL
DATABASE_URL=postgres://param@localhost:5432/exchange

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Kafka (comma separated)
KAFKA_BROKERS=localhost:9092

# Fees (bps)
FEE_MODE=taker_only
MAKER_FEE_BPS=10
TAKER_FEE_BPS=20

# ---- C++ Engine (export in shell or via .env at Engine/) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_STREAM_ORDER_COMMANDS=order_commands
REDIS_CONSUMER_GROUP=engine-group
REDIS_CONSUMER_NAME=engine-1
REDIS_EVENTS_CHANNEL=engine_events
KAFKA_ENGINE_EVENTS_TOPIC=engine_events
SNAPSHOT_PATH=engine_state.json
SNAPSHOT_INTERVAL_SECONDS=900
